<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#383049"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Utility Bills Calculator"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>


    <!-- Floating Action Button -->
    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="120dp"
        app:layout_anchor="@+id/scrollView2"
        app:layout_anchorGravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gallons of water"
                    android:textSize="17sp"
                    android:textStyle="bold|italic" />

                <EditText
                    android:id="@+id/etGallons"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:hint="0.00"
                    android:inputType="numberDecimal" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="376dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kilowatts of Electricity"
                    android:textSize="17sp"
                    android:textStyle="bold|italic" />

                <EditText
                    android:id="@+id/etKilowatts"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:hint="0.00"
                    android:inputType="numberDecimal" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Results"
                android:textSize="16sp"
                android:textStyle="bold|italic" />


            <LinearLayout
                android:layout_width="378dp"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Water Bill"
                    android:textStyle="bold|italic" />

                <TextView
                    android:id="@+id/tvWater"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#D3D3D3"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:text="₵0.00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="Electricity Bill"
                    android:textStyle="bold|italic" />

                <TextView
                    android:id="@+id/tvElectricity"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#D3D3D3"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:text="₵0.00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="Total Bill"
                    android:textStyle="bold|italic" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#D3D3D3"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:text="₵0.00"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="24dp">

                <!-- CALCULATE (Primary / Bigger) -->
                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="150dp"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/black"
                    android:maxLines="1"
                    android:text="CALCULATE"
                    android:textColor="#FFFFFF" />

                <!-- NEW -->
                <Button
                    android:id="@+id/btnNew"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="@color/black"
                    android:maxLines="1"
                    android:text="NEW"
                    android:textColor="#FFFFFF" />

                <!-- EXIT -->
                <Button
                    android:id="@+id/btnExit"
                    android:layout_width="100dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:backgroundTint="@color/black"
                    android:maxLines="1"
                    android:text="EXIT"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="bottom"
        android:background="#392E4D"
        android:gravity="center"
        android:orientation="vertical" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="60dp"
        android:contentDescription="Programmer Info"
        android:src="@android:drawable/ic_dialog_info"
        app:layout_anchor="@+id/linearLayout"
        app:layout_anchorGravity="center" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
